{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "__EDGEWISE_HOOK__ working", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "__EDGEWISE_HOOK__ needs_you", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__EDGEWISE_HOOK__ done", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "__EDGEWISE_HOOK__ clear", "timeout": 5 }
        ]
      }
    ]
  }
}
